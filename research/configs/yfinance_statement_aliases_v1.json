{
  "version": "YF-ALIAS-1.0.0",
  "missing_rule": "Unknown remains missing; no positional assumptions and no zero imputation.",
  "fields": {
    "revenue": {"aliases": ["TotalRevenue", "OperatingRevenue"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "positive revenue", "units": "financial currency", "limitations": "May be noncomparable for banks; Financial Services excluded."},
    "cost_revenue": {"aliases": ["CostOfRevenue", "ReconciledCostOfRevenue"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "positive expense", "units": "financial currency", "limitations": "Often absent where Yahoo does not classify cost of revenue."},
    "gross_profit": {"aliases": ["GrossProfit"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "positive profit", "units": "financial currency", "limitations": "Not comparable or often absent for service and financial firms."},
    "operating_income": {"aliases": ["OperatingIncome", "TotalOperatingIncomeAsReported"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "signed profit", "units": "financial currency", "limitations": "Reported and normalized definitions may differ."},
    "ebit": {"aliases": ["EBIT", "OperatingIncome", "TotalOperatingIncomeAsReported"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "signed profit", "units": "financial currency", "limitations": "Operating income is an explicit fallback, not assumed identical."},
    "ebitda": {"aliases": ["EBITDA", "NormalizedEBITDA"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "signed profit", "units": "financial currency", "limitations": "Normalized EBITDA may embed Yahoo adjustments."},
    "depreciation_amortization": {"aliases": ["ReconciledDepreciation", "DepreciationAndAmortizationInIncomeStatement", "DepreciationAmortizationDepletionIncomeStatement"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income", "trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "positive expense/add-back", "units": "financial currency", "limitations": "Cash-flow and income-statement D&A may differ."},
    "net_income": {"aliases": ["NetIncome", "NetIncomeCommonStockholders", "NetIncomeFromContinuingOperationNetMinorityInterest"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "signed profit", "units": "financial currency", "limitations": "Attribution and continuing-operations definitions differ."},
    "interest_expense": {"aliases": ["InterestExpense", "InterestExpenseNonOperating"], "preferred": ["trailing_income", "quarterly_income:sum4", "annual_income"], "frequency": "flow", "sign": "positive expense expected; absolute value used in coverage", "units": "financial currency", "limitations": "Net and gross interest presentation varies."},
    "total_assets": {"aliases": ["TotalAssets"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "positive", "units": "financial currency", "limitations": "Current/restated balance-sheet observation."},
    "stockholders_equity": {"aliases": ["StockholdersEquity", "CommonStockEquity", "TotalEquityGrossMinorityInterest"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "signed equity", "units": "financial currency", "limitations": "Common and total equity are not identical; ordered fallbacks are recorded."},
    "total_debt": {"aliases": ["TotalDebt", "LongTermDebtAndCapitalLeaseObligation"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "positive obligation", "units": "financial currency", "limitations": "Fallback may omit current debt."},
    "cash": {"aliases": ["CashCashEquivalentsAndShortTermInvestments", "CashAndCashEquivalents", "CashFinancial"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "positive asset", "units": "financial currency", "limitations": "Fallbacks differ in short-term investments included."},
    "preferred_stock": {"aliases": ["PreferredStock", "PreferredStockEquity"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "positive claim", "units": "financial currency", "limitations": "Sparse."},
    "minority_interest": {"aliases": ["MinorityInterest"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "positive claim", "units": "financial currency", "limitations": "Sparse; broad liability rows are deliberately not accepted as aliases."},
    "ordinary_shares": {"aliases": ["OrdinarySharesNumber", "ShareIssued"], "preferred": ["quarterly_balance", "annual_balance"], "frequency": "stock", "sign": "positive shares", "units": "shares", "limitations": "Issued and outstanding shares differ when treasury stock exists."},
    "operating_cash_flow": {"aliases": ["OperatingCashFlow", "TotalCashFromOperatingActivities"], "preferred": ["trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "signed cash inflow", "units": "financial currency", "limitations": "Working-capital classification may vary."},
    "capital_expenditure": {"aliases": ["CapitalExpenditure", "CapitalExpenditures"], "preferred": ["trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "Yahoo normally negative cash outflow", "units": "financial currency", "limitations": "Sign is empirically reconciled per snapshot."},
    "free_cash_flow": {"aliases": ["FreeCashFlow"], "preferred": ["trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "signed cash flow", "units": "financial currency", "limitations": "Reconciled against OCF plus negative capex."},
    "dividends_paid": {"aliases": ["CommonStockDividendPaid", "CashDividendsPaid"], "preferred": ["trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "normally negative outflow", "units": "financial currency", "limitations": "Sparse and sign-sensitive."},
    "repurchases": {"aliases": ["RepurchaseOfCapitalStock", "RepurchaseOfStock"], "preferred": ["trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "normally negative outflow", "units": "financial currency", "limitations": "May be gross or net presentation."},
    "issuance": {"aliases": ["IssuanceOfCapitalStock", "CommonStockIssuance", "IssuanceOfStock"], "preferred": ["trailing_cashflow", "quarterly_cashflow:sum4", "annual_cashflow"], "frequency": "flow", "sign": "normally positive inflow", "units": "financial currency", "limitations": "May include employee-plan issuance."}
  }
}
